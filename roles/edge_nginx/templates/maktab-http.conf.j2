proxy_cache_path /var/cache/nginx/static levels=1:2 keys_zone=static_cache:20m max_size=1g inactive=7d use_temp_path=off;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

upstream wordpress {
    server {{ hub_ip }}:{{ np_wordpress }};
    server {{ worker_ip }}:{{ np_wordpress }} max_fails=2 fail_timeout=10s;
}
upstream frontend {
    server {{ hub_ip }}:{{ np_frontend }};
    server {{ worker_ip }}:{{ np_frontend }} max_fails=2 fail_timeout=10s;
}
upstream backend {
    server {{ hub_ip }}:{{ np_backend }};
    server {{ worker_ip }}:{{ np_backend }} max_fails=2 fail_timeout=10s;
}
