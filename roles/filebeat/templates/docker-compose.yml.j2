services:
  filebeat:
    image: hub.hamdocker.ir/elastic/filebeat:{{ elk_version }}
    container_name: filebeat
    user: root
    restart: unless-stopped
    mem_limit: 128m
    command: ["filebeat", "-e", "--strict.perms=false"]
    volumes:
      - ./filebeat.yml:/usr/share/filebeat/filebeat.yml:ro
      - /var/log:/var/log:ro
      - /srv/filebeat:/usr/share/filebeat/data
