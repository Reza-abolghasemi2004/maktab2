filebeat.inputs:
{% if inventory_hostname in groups['edge'] %}
  - type: filestream
    id: nginx-access
    paths: [/var/log/nginx/access.log]
    fields: { type: nginx }
{% endif %}
  - type: filestream
    id: system
    paths: [/var/log/syslog, /var/log/auth.log]
    fields: { type: syslog }
output.logstash:
  hosts: ["{{ worker_ip }}:5044"]
logging.level: warning
