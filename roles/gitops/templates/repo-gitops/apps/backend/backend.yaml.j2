apiVersion: apps/v1
kind: Deployment
metadata: { name: backend, namespace: apps, labels: { app: backend } }
spec:
  replicas: 2
  selector: { matchLabels: { app: backend } }
  template:
    metadata: { labels: { app: backend, tier: web } }
    spec:
      containers:
        - name: backend
          image: {{ registry_endpoint }}/{{ gitea_org }}/backend:latest
          ports: [{ containerPort: 8080 }]
          env:
            - { name: PGHOST, value: pg-main-rw.data.svc.cluster.local }
            - { name: PGUSER, valueFrom: { secretKeyRef: { name: backend-db, key: username } } }
            - { name: PGPASSWORD, valueFrom: { secretKeyRef: { name: backend-db, key: password } } }
            - { name: PGDATABASE, valueFrom: { secretKeyRef: { name: backend-db, key: dbname } } }
            - { name: REDIS_HOST, value: redis.data.svc.cluster.local }
            - { name: REDIS_PASSWORD, valueFrom: { secretKeyRef: { name: redis-credentials, key: password } } }
          readinessProbe: { httpGet: { path: /healthz, port: 8080 }, periodSeconds: 10 }
          resources: { requests: { cpu: 25m, memory: 64Mi }, limits: { memory: 192Mi } }
---
apiVersion: v1
kind: Service
metadata: { name: backend, namespace: apps }
spec:
  type: NodePort
  selector: { app: backend }
  ports: [{ port: 8080, targetPort: 8080, nodePort: {{ np_backend }} }]
