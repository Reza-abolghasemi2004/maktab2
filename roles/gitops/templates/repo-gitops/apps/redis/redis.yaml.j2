apiVersion: apps/v1
kind: Deployment
metadata: { name: redis, namespace: data, labels: { app: redis } }
spec:
  replicas: 1
  selector: { matchLabels: { app: redis } }
  template:
    metadata: { labels: { app: redis } }
    spec:
      containers:
        - name: redis
          image: redis:7-alpine
          args: ["redis-server", "--requirepass", "$(REDIS_PASSWORD)", "--maxmemory", "128mb", "--maxmemory-policy", "allkeys-lru"]
          env:
            - { name: REDIS_PASSWORD, valueFrom: { secretKeyRef: { name: redis-credentials, key: password } } }
          ports: [{ containerPort: 6379 }]
          readinessProbe: { tcpSocket: { port: 6379 } }
          resources: { requests: { cpu: 10m, memory: 32Mi }, limits: { memory: 192Mi } }
---
apiVersion: v1
kind: Service
metadata: { name: redis, namespace: data }
spec:
  selector: { app: redis }
  ports: [{ port: 6379, targetPort: 6379 }]
