apiVersion: v1
kind: PersistentVolumeClaim
metadata: { name: wordpress-content, namespace: apps }
spec:
  accessModes: [ReadWriteMany]
  storageClassName: nfs-client
  resources: { requests: { storage: 5Gi } }
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: wordpress, namespace: apps, labels: { app: wordpress } }
spec:
  replicas: 1
  selector: { matchLabels: { app: wordpress } }
  template:
    metadata: { labels: { app: wordpress, tier: web } }
    spec:
      containers:
        - name: wordpress
          image: wordpress:6.6-apache        # پیش‌فرض، بدون config سفارشی
          env:
            - { name: WORDPRESS_DB_HOST, value: "mariadb.data.svc.cluster.local:3306" }
            - { name: WORDPRESS_DB_USER, valueFrom: { secretKeyRef: { name: wordpress-db, key: username } } }
            - { name: WORDPRESS_DB_PASSWORD, valueFrom: { secretKeyRef: { name: wordpress-db, key: password } } }
            - { name: WORDPRESS_DB_NAME, valueFrom: { secretKeyRef: { name: wordpress-db, key: dbname } } }
          ports: [{ containerPort: 80 }]
          readinessProbe: { tcpSocket: { port: 80 }, initialDelaySeconds: 20 }
          resources: { requests: { cpu: 50m, memory: 128Mi }, limits: { memory: 512Mi } }
          volumeMounts: [{ name: content, mountPath: /var/www/html }]
      volumes:
        - name: content
          persistentVolumeClaim: { claimName: wordpress-content }
---
apiVersion: v1
kind: Service
metadata: { name: wordpress, namespace: apps }
spec:
  type: NodePort
  selector: { app: wordpress }
  ports: [{ port: 80, targetPort: 80, nodePort: {{ np_wordpress }} }]
