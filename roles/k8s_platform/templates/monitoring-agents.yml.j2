---
apiVersion: v1
kind: ServiceAccount
metadata: { name: kube-state-metrics, namespace: monitoring }
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata: { name: kube-state-metrics }
rules:
  - apiGroups: [""]
    resources: [nodes, pods, services, namespaces, persistentvolumeclaims, persistentvolumes, endpoints]
    verbs: [list, watch]
  - apiGroups: [apps]
    resources: [deployments, statefulsets, daemonsets, replicasets]
    verbs: [list, watch]
  - apiGroups: [batch]
    resources: [jobs, cronjobs]
    verbs: [list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata: { name: kube-state-metrics }
subjects: [{ kind: ServiceAccount, name: kube-state-metrics, namespace: monitoring }]
roleRef: { kind: ClusterRole, name: kube-state-metrics, apiGroup: rbac.authorization.k8s.io }
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: kube-state-metrics, namespace: monitoring }
spec:
  replicas: 1
  selector: { matchLabels: { app: kube-state-metrics } }
  template:
    metadata: { labels: { app: kube-state-metrics } }
    spec:
      serviceAccountName: kube-state-metrics
      containers:
        - name: ksm
          image: registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.13.0
          args:
            - --resources=nodes,pods,services,namespaces,persistentvolumeclaims,persistentvolumes,deployments,statefulsets,daemonsets,replicasets,jobs,cronjobs
          ports: [{ containerPort: 8080 }]
          resources: { requests: { cpu: 10m, memory: 32Mi }, limits: { memory: 128Mi } }
---
apiVersion: v1
kind: Service
metadata: { name: kube-state-metrics, namespace: monitoring }
spec:
  type: NodePort
  selector: { app: kube-state-metrics }
  ports: [{ port: 8080, targetPort: 8080, nodePort: {{ np_ksm }} }]
---
apiVersion: v1
kind: ConfigMap
metadata: { name: blackbox-k8s, namespace: monitoring }
data:
  blackbox.yml: |
    modules:
      tcp_connect:
        prober: tcp
        timeout: 5s
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: blackbox-k8s, namespace: monitoring }
spec:
  replicas: 1
  selector: { matchLabels: { app: blackbox-k8s } }
  template:
    metadata: { labels: { app: blackbox-k8s } }
    spec:
      containers:
        - name: blackbox
          image: {{ blackbox_image }}
          args: ["--config.file=/etc/blackbox/blackbox.yml"]
          ports: [{ containerPort: 9115 }]
          volumeMounts: [{ name: cfg, mountPath: /etc/blackbox }]
          resources: { requests: { cpu: 5m, memory: 16Mi }, limits: { memory: 64Mi } }
      volumes: [{ name: cfg, configMap: { name: blackbox-k8s } }]
---
apiVersion: v1
kind: Service
metadata: { name: blackbox-k8s, namespace: monitoring }
spec:
  type: NodePort
  selector: { app: blackbox-k8s }
  ports: [{ port: 9115, targetPort: 9115, nodePort: {{ np_blackbox_k8s }} }]
