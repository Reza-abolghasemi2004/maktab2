---
apiVersion: v1
kind: Secret
metadata: { name: pg-app-credentials, namespace: data }
type: kubernetes.io/basic-auth
data:
  username: {{ 'app' | b64encode }}
  password: {{ pg_app_password | b64encode }}
---
apiVersion: v1
kind: Secret
metadata: { name: backend-db, namespace: apps }
data:
  username: {{ 'app' | b64encode }}
  password: {{ pg_app_password | b64encode }}
  dbname: {{ 'app' | b64encode }}
---
apiVersion: v1
kind: Secret
metadata: { name: redis-credentials, namespace: data }
data: { password: {{ redis_password | b64encode }} }
---
apiVersion: v1
kind: Secret
metadata: { name: redis-credentials, namespace: apps }
data: { password: {{ redis_password | b64encode }} }
---
apiVersion: v1
kind: Secret
metadata: { name: mariadb-credentials, namespace: data }
data:
  root-password: {{ mariadb_root_password | b64encode }}
  password: {{ mariadb_wp_password | b64encode }}
---
apiVersion: v1
kind: Secret
metadata: { name: wordpress-db, namespace: apps }
data:
  username: {{ 'wordpress' | b64encode }}
  password: {{ mariadb_wp_password | b64encode }}
  dbname: {{ 'wordpress' | b64encode }}
