{
  "uid": "nginx-traffic",
  "title": "Nginx Traffic",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "table", "title": "Top 50 requests (count, avg upstream time, last status, last cache status)",
      "datasource": { "type": "elasticsearch", "uid": "es-nginx" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 0 },
      "targets": [{
        "refId": "A", "datasource": { "type": "elasticsearch", "uid": "es-nginx" }, "query": "", "timeField": "@timestamp",
        "metrics": [
          { "id": "1", "type": "count" },
          { "id": "2", "type": "avg", "field": "upstream_response_time" },
          { "id": "3", "type": "top_metrics", "settings": { "metrics": ["status"], "order": "desc", "orderBy": "@timestamp" } },
          { "id": "4", "type": "top_metrics", "settings": { "metrics": ["cache_status"], "order": "desc", "orderBy": "@timestamp" } }
        ],
        "bucketAggs": [
          { "id": "5", "type": "terms", "field": "uri", "settings": { "size": "50", "order": "desc", "orderBy": "_count", "min_doc_count": "1" } }
        ]
      }]
    },
    {
      "id": 2, "type": "table", "title": "Last 50 requests (raw)",
      "datasource": { "type": "elasticsearch", "uid": "es-nginx" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 14 },
      "targets": [{
        "refId": "A", "datasource": { "type": "elasticsearch", "uid": "es-nginx" }, "query": "", "timeField": "@timestamp",
        "metrics": [{ "id": "1", "type": "raw_data", "settings": { "size": "50" } }],
        "bucketAggs": []
      }]
    },
    {
      "id": 3, "type": "piechart", "title": "Cache status of requests",
      "datasource": { "type": "elasticsearch", "uid": "es-nginx" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 26 },
      "options": { "reduceOptions": { "values": true, "calcs": [], "fields": "/^Count$/" }, "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "targets": [{
        "refId": "A", "datasource": { "type": "elasticsearch", "uid": "es-nginx" }, "query": "", "timeField": "@timestamp",
        "metrics": [{ "id": "1", "type": "count" }],
        "bucketAggs": [{ "id": "2", "type": "terms", "field": "cache_status", "settings": { "size": "10", "order": "desc", "orderBy": "_count", "min_doc_count": "1" } }]
      }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Requests per time",
      "datasource": { "type": "elasticsearch", "uid": "es-nginx" },
      "gridPos": { "h": 9, "w": 16, "x": 8, "y": 26 },
      "targets": [{
        "refId": "A", "datasource": { "type": "elasticsearch", "uid": "es-nginx" }, "query": "", "timeField": "@timestamp",
        "metrics": [{ "id": "1", "type": "count" }],
        "bucketAggs": [{ "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }]
      }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Requests per status code",
      "datasource": { "type": "elasticsearch", "uid": "es-nginx" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 35 },
      "targets": [{
        "refId": "A", "datasource": { "type": "elasticsearch", "uid": "es-nginx" }, "query": "", "timeField": "@timestamp",
        "metrics": [{ "id": "1", "type": "count" }],
        "bucketAggs": [
          { "id": "2", "type": "terms", "field": "status", "settings": { "size": "10", "order": "desc", "orderBy": "_count", "min_doc_count": "1" } },
          { "id": "3", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "auto", "min_doc_count": "0" } }
        ]
      }]
    }
  ]
}
