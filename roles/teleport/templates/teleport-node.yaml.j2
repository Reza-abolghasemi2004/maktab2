version: v3
teleport:
  nodename: {{ inventory_hostname }}
  data_dir: /var/lib/teleport
  proxy_server: {{ hub_ip }}:3080
  join_params: { method: token, token_name: "{{ teleport_node_token }}" }
  log: { output: stderr, severity: INFO }
auth_service: { enabled: false }
proxy_service: { enabled: false }
ssh_service:
  enabled: true
  labels: { role: worker, env: prod }
